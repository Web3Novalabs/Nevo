# Sentry - Error Monitoring
# Get these from https://sentry.io/settings/<org>/projects/<project>/keys/
NEXT_PUBLIC_SENTRY_DSN=

# Used during build for source map uploads (optional)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Required frontend runtime config
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC Configuration
# URL of the Soroban RPC server for contract interactions
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Network Configuration
# Network passphrase for transaction signing.
# Leave empty to derive it automatically from NEXT_PUBLIC_STELLAR_NETWORK
# (testnet => "Test SDF Network ; September 2015", mainnet => "Public Global Stellar Network ; September 2015").
NEXT_PUBLIC_NETWORK_PASSPHRASE=

# Horizon Configuration (optional)
# URL of the Horizon server used to query account balances.
# Leave empty to derive it from NEXT_PUBLIC_STELLAR_NETWORK
# (testnet => https://horizon-testnet.stellar.org, mainnet => https://horizon.stellar.org).
NEXT_PUBLIC_HORIZON_URL=

# Contract Configuration
# ID of the deployed Nevo smart contract
NEXT_PUBLIC_CONTRACT_ID=

# API Rate Limiting
# Maximum number of API requests allowed within the rate limit window
NEXT_PUBLIC_API_RATE_LIMIT_MAX_REQUESTS=60
# Time window in milliseconds for rate limiting
NEXT_PUBLIC_API_RATE_LIMIT_WINDOW_MS=60000