# Database connection string. When set it takes precedence over the individual
# DB_* vars below; leave it unset to fall back to them.
DATABASE_URL=postgresql://user:password@localhost:5432/nevo

# Individual database settings, used only when DATABASE_URL is unset.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nevo

# JSON Web Token secret key
JWT_SECRET=your-secret-here

# JWT token expiration duration (e.g. 15m, 1h, 7d).
# Leave unset to fall back to 7d.
JWT_EXPIRY=15m

# Stellar network to connect to (testnet or mainnet)
STELLAR_NETWORK=testnet

# Stellar RPC endpoint URL
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Horizon endpoint URL
HORIZON_URL=https://horizon-testnet.stellar.org

# Contract ID (address) of the deployed smart contract
CONTRACT_ID=your-contract-id-here

# Contract ID (address) of the Stellar token paid out by pool withdrawals.
# Required to build withdraw transactions (POST /pools/:id/withdraw).
TOKEN_ADDRESS=your-token-contract-address-here

# Stellar secret key used ONLY as the source account for read-only simulated
# contract calls (getPoolOnChain, getTotalRaisedOnChain, ...). Those
# transactions are simulated and never signed or submitted, so this account is
# never charged. It does have to exist on the network — on testnet, create a
# throwaway keypair and fund it via friendbot. NEVER use a production key or
# any key holding real value here. Leave unset to fall back to a random
# keypair, which will only work if that account happens to exist on-chain.
SOURCE_SECRET_KEY=your-throwaway-stellar-secret-key

# NestJS server port
PORT=3000

# Allowed CORS origin(s) for the frontend. Comma-separated for multiple origins.
FRONTEND_ORIGIN=http://localhost:3000
